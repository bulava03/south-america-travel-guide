# Optional for `docker compose up`: without .env the dev defaults from docker-compose.yml are used.
# Copy to .env to set your own passwords (needed before any real deployment). .env is not committed.

# MySQL user (created by the mysql container on first start)
DB_USERNAME=guide
DB_PASSWORD=change_me

# Admin panel login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Only for running the app from the IDE against the MySQL container
DB_URL=jdbc:mysql://localhost:3307/south_america_guide?useSSL=false&allowPublicKeyRetrieval=true

# Optional: how many attractions to sync per country and per type in a country
# SYNC_PER_COUNTRY_LIMIT=25
# SYNC_MAX_PER_TYPE=4
